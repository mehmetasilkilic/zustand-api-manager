{
  "name": "zustand-api-manager",
  "version": "2.0.0",
  "description": "A Zustand plugin for managing API states",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "zustand",
    "api",
    "state-management",
    "typescript",
    "react",
    "hooks",
    "cache",
    "fetch",
    "query",
    "mutation",
    "swr",
    "react-query",
    "data-fetching",
    "api-client",
    "async"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mehmetasilkilic/zustand-api-manager"
  },
  "homepage": "https://github.com/mehmetasilkilic/zustand-api-manager#readme",
  "bugs": {
    "url": "https://github.com/mehmetasilkilic/zustand-api-manager/issues"
  },
  "author": {
    "name": "Mehmet Asil Kılıç",
    "url": "https://github.com/mehmetasilkilic/"
  },
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.28",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.20.1",
    "happy-dom": "^20.6.1",
    "husky": "^9.0.0",
    "immer": "^11.1.4",
    "lint-staged": "^15.2.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.0.18",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "immer": ">=10.0.0",
    "react": ">=17.0.0",
    "zustand": ">=5.0.0"
  }
}
